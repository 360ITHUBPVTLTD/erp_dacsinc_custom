 "fields": [
  {
   "fieldname": "section_payment",
   "fieldtype": "Section Break",
   "label": "Payment"
  },
  {
   "default": "BPAY-.YY.-",
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Series",
   "no_copy": 1,
   "options": "BPAY-.YY.-",
   "print_hide": 1,
   "reqd": 1
  },
  {
   "default": "Receive",
   "description": "Receive: one amount from customers. Pay: one amount to suppliers / jobbers.",
   "fieldname": "payment_type",
   "fieldtype": "Select",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "label": "Payment Type",
   "options": "Receive\nPay",
   "reqd": 1
  },
  {
   "default": "Customer",
   "fieldname": "party_type",
   "fieldtype": "Select",
   "label": "Party Type",
   "options": "Customer\nSupplier",
   "read_only": 1
  },
  {
   "default": "Today",
   "fieldname": "posting_date",
   "fieldtype": "Date",
   "in_list_view": 1,
   "label": "Payment Date",
   "reqd": 1
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "mode_of_payment",
   "fieldtype": "Link",
   "in_list_view": 1,
   "label": "Mode of Payment",
   "options": "Mode of Payment",
   "reqd": 1
  },
  {
   "description": "From the Mode of Payment",
   "fieldname": "bank_cash_account",
   "fieldtype": "Link",
   "label": "Bank / Cash Account",
   "options": "Account",
   "read_only": 1
  },
  {
   "fieldname": "company",
   "fieldtype": "Link",
   "label": "Company",
   "options": "Company",
   "print_hide": 1,
   "reqd": 1
  },
  {
   "fieldname": "section_amount",
   "fieldtype": "Section Break",
   "label": "Amount"
  },
  {
   "description": "What the invoices are cleared by: the money in the bank / cash plus any bank charges, TDS or write-off.",
   "fieldname": "total_amount",
   "fieldtype": "Currency",
   "in_list_view": 1,
   "label": "Total Amount (settled)",
   "options": "Company:company:default_currency",
   "reqd": 1
  },
  {
   "fieldname": "allocated_amount",
   "fieldtype": "Currency",
   "label": "Allocated",
   "options": "Company:company:default_currency",
   "read_only": 1
  },
  {
   "fieldname": "bank_amount",
   "fieldtype": "Currency",
   "label": "Amount in Bank / Cash",
   "read_only": 1,
   "description": "Receive: total − bank charges − TDS − write-off. Pay: total − TDS − write-off + bank charges."
  },
  {
   "fieldname": "column_break_2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "reference_no",
   "fieldtype": "Data",
   "in_standard_filter": 1,
   "label": "Cheque / Reference No"
  },
  {
   "fieldname": "reference_date",
   "fieldtype": "Date",
   "label": "Cheque / Reference Date"
  },
  {
   "fieldname": "section_deductions",
   "fieldtype": "Section Break",
   "label": "Bank Charges, TDS, Write-off",
   "collapsible": 1,
   "collapsible_depends_on": "eval:doc.bank_charges || doc.tds_amount || doc.write_off_amount"
  },
  {
   "fieldname": "bank_charges",
   "fieldtype": "Currency",
   "label": "Bank Charges",
   "description": "For the whole amount (Receive: cut by the bank; Pay: paid by us on top). Posted on the first party's Payment Entry."
  },
  {
   "fieldname": "bank_charges_account",
   "fieldtype": "Link",
   "label": "Bank Charges Account",
   "options": "Account",
   "mandatory_depends_on": "eval:doc.bank_charges"
  },
  {
   "fieldname": "tds_amount",
   "fieldtype": "Currency",
   "label": "TDS (total of the rows)",
   "read_only": 1
  },
  {
   "fieldname": "column_break_4",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "tds_account",
   "fieldtype": "Link",
   "label": "TDS Account",
   "options": "Account",
   "description": "Blank: TDS Receivable for customers; each supplier's own TDS ledger for suppliers."
  },
  {
   "fieldname": "write_off_amount",
   "fieldtype": "Currency",
   "label": "Write-off (total of the rows)",
   "read_only": 1
  },
  {
   "fieldname": "write_off_account",
   "fieldtype": "Link",
   "label": "Write Off Account",
   "options": "Account",
   "mandatory_depends_on": "eval:doc.write_off_amount"
  },
  {
   "fieldname": "section_allocations",
   "fieldtype": "Section Break",
   "label": "Customers / Suppliers and Invoices"
  },
  {
   "fieldname": "allocations",
   "fieldtype": "Table",
   "label": "Allocations",
   "options": "Bulk Payment Allocation",
   "reqd": 1
  },
  {
   "fieldname": "section_summary",
   "fieldtype": "Section Break",
   "label": "Summary"
  },
  {
   "fieldname": "party_count",
   "fieldtype": "Int",
   "label": "Parties",
   "read_only": 1
  },
  {
   "fieldname": "invoice_count",
   "fieldtype": "Int",
   "label": "Invoices",
   "read_only": 1
  },
  {
   "fieldname": "column_break_3",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "payment_entries",
   "fieldtype": "Small Text",
   "label": "Payment Entries",
   "no_copy": 1,
   "read_only": 1,
   "allow_on_submit": 1
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Draft\nSubmitted\nPartly Cancelled\nCancelled",
   "default": "Draft",
   "read_only": 1,
   "allow_on_submit": 1,
   "no_copy": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "Partly Cancelled: one or more of its Payment Entries were cancelled on their own; the rest stand."
  },
  {
   "fieldname": "cancelled_amount",
   "fieldtype": "Currency",
   "label": "Cancelled Amount",
   "options": "Company:company:default_currency",
   "read_only": 1,
   "allow_on_submit": 1,
   "no_copy": 1,
   "depends_on": "eval:doc.cancelled_amount",
   "description": "Received / paid amount of the Payment Entries cancelled on their own."
  },
  {
   "fieldname": "remarks",
   "fieldtype": "Small Text",
   "label": "Remarks"
  },
  {
   "fieldname": "amended_from",
   "fieldtype": "Link",
   "label": "Amended From",
